# Spycam 自定义规则（M2：仓库内规则 ≥5 条；metadata 必含 stage/mitre，供 S3/C3 使用）
# sid 从 1000001 连续分配

# 1000001 端口扫描：10s 内同源 ≥20 个 SYN（排除 22/80 专属端口段，避免与业务/爆破规则重叠误报）
alert tcp any any -> $HOME_NET [1:21,23:79,81:200] (msg:"SPYCAM SYN port scan to low ports"; flags:S; flow:stateless; detection_filter:track by_src, count 20, seconds 10; classtype:attempted-recon; metadata:stage recon, mitre_tactic TA0007 Discovery, mitre_technique T1046 Network Service Discovery, author spycam; sid:1000001; rev:3;)

# 1000002 SSH 爆破：60s 内同源对 22 端口 ≥10 次 SYN（源 any：内网横向同样检出）
alert tcp any any -> $HOME_NET 22 (msg:"SPYCAM SSH bruteforce burst"; flags:S; flow:stateless; detection_filter:track by_src, count 10, seconds 60; classtype:attempted-admin; metadata:stage bruteforce, mitre_tactic TA0006 Credential Access, mitre_technique T1110 Brute Force, author spycam; sid:1000002; rev:2;)

# 1000003 SQL 注入：UNION SELECT 特征
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"SPYCAM SQLi UNION SELECT in URI or body"; flow:established,to_server; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; metadata:stage exploit, mitre_tactic TA0001 Initial Access, mitre_technique T1190 Exploit Public-Facing Application, author spycam; sid:1000003; rev:1;)

# 1000004 XSS 注入：URI 含 URL 编码的 <script 与 onerror（libhtp 会解 %3C 后匹配 normalized uri）
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SPYCAM XSS script tag with event handler"; flow:established,to_server; http.uri; pcre:"/(%3C|<)script.*(onerror|%20onerror)/iU"; classtype:web-application-attack; metadata:stage exploit, mitre_tactic TA0001 Initial Access, mitre_technique T1059.007 JavaScript/JScript, author spycam; sid:1000004; rev:4;)

# 1000005 DNS 隧道：超长 qname 标签（≥40 字符）；目标 any（内网 DNS 转发/外带均检出）
alert dns $HOME_NET any -> any 53 (msg:"SPYCAM DNS tunnel long label query"; dns.query; pcre:"/^[a-z0-9]{40,}\./i"; classtype:policy-violation; metadata:stage c2, mitre_tactic TA0011 Command and Control, mitre_technique T1071.004 DNS, author spycam; sid:1000005; rev:2;)

# 1000006 C2 心跳：60s 内 ≥10 次固定路径 POST
alert http $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"SPYCAM C2 beacon fixed path POST burst"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/collect"; startswith; detection_filter:track by_src, count 10, seconds 60; classtype:command-and-control; metadata:stage c2, mitre_tactic TA0011 Command and Control, mitre_technique T1071.001 Web Protocols, author spycam; sid:1000006; rev:1;)
