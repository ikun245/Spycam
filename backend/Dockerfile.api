# API 镜像：多阶段构建，静态编译（架构设计 §6.2）
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/api ./cmd/api

FROM alpine:3.20
RUN adduser -D -u 10001 app && apk add --no-cache ca-certificates curl
# 预创建挂载点并赋属主：命名卷首挂时会把该目录属主带进去（app uid 10001 可写）
RUN mkdir -p /data/pcaps /rules-active && chown -R app:app /data /rules-active
USER app
WORKDIR /app
COPY --from=build /out/api /app/api
COPY --from=build /src/migrations /app/migrations
# 种子规则从后端构建上下文内的副本读取（COPY 不能越过上下文根）
COPY seed-rules/spycam.rules /app/seed-rules/spycam.rules
EXPOSE 8081
ENTRYPOINT ["/app/api"]
