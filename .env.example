# 复制为 .env 后修改；.env 不进 git（M7）
# 数据库
POSTGRES_USER=spycam
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=spycam
DATABASE_URL=postgres://spycam:change-me-strong@postgres:5432/spycam?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# API
API_LISTEN=:8081
SESSION_TTL=12h
ENGINE_AGENT_TOKEN=change-me-random-token
ENGINE_AGENT_URL=http://suricata:9090

# 初始管理员账号（首次启动种子化）
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=change-me-admin

# Web 对外地址：默认只绑本机回环，由宿主机 nginx/Caddy 反代；
# 确需直接公网访问时改 WEB_BIND=0.0.0.0 并放行 WEB_PORT（防火墙/安全组）
WEB_BIND=127.0.0.1
WEB_PORT=8080
# 浏览器经 HTTPS 访问时设 true；纯 HTTP 访问必须为 false，否则登录 Cookie 不会被保存
COOKIE_SECURE=false

# 告警聚合窗口（秒，S1 可配置 N）
AGG_WINDOW_SECONDS=60
